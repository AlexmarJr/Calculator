# Allow only build inputs. Paths are relative to backend/, the build context.
**
!go.mod
!go.sum
!cmd/
!cmd/**
!api/
!api/**
!tests/
!tests/**

# Never send local secrets, binaries, or generated reports within source folders.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.exe
**/*.test
**/*.log
**/coverage*
