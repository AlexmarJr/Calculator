# Allow only build inputs. Paths are relative to frontend/, the build context.
**
!package.json
!package-lock.json
!index.html
!tsconfig*.json
!vite.config.ts
!nginx.conf
!src/
!src/**
!public/
!public/**
!tests/
!tests/**

# Never send local secrets or generated reports within source folders.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.log
**/coverage/
**/node_modules/
**/dist/
